# Used by docker-compose.yml. Copy to .env and replace every value.

# Signs the API's JWTs (HMAC-SHA256, at least 32 characters). e.g. openssl rand -base64 48
JWT_SECRET=

# Encrypts the Next.js session cookie. e.g. npx auth secret, or openssl rand -base64 33
AUTH_SECRET=

MYSQL_PASSWORD=terruno
MYSQL_ROOT_PASSWORD=root

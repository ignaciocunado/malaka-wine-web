# Copy to .env.local for local development.

# Where the Spring Boot API runs (called from the Next.js server only, never from the browser).
BACKEND_URL=http://localhost:8080

# Auth.js secret used to encrypt the session cookie. Generate one with: npx auth secret
AUTH_SECRET=replace-me

# Production builds (`next start`, Docker) only accept requests for a trusted host. Either trust the Host
# header (fine on localhost or behind a proxy that sets it), or pin the site's public URL with AUTH_URL.
AUTH_TRUST_HOST=true
# AUTH_URL=https://terruno.example.com
